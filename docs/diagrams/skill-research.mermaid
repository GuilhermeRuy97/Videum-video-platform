%%{init: {'theme': 'dark'}}%%
flowchart LR
    subgraph INPUT["📥 Input"]
        plan["project-plan.md\n(capabilities)"]
        decisions["decisions/\n(previous decisions)"]
    end

    subgraph PROCESS["🔍 Research"]
        identify["Identify<br/>technical decisions"]
        research["Research options\n(Context7, Web)"]
        evaluate["Evaluate trade-offs"]
        recommend["Recommend"]
    end

    subgraph OUTPUT["📤 Output"]
        doc["technical-decisions-phase-NN.md<br/>(TD-01, TD-02...)"]
    end

    plan --> identify
    decisions --> identify
    identify --> research
    research --> evaluate
    evaluate --> recommend
    recommend --> doc

    classDef input fill:#42A5F5,stroke:#1E88E5,color:#FFF
    classDef process fill:#FF7043,stroke:#E64A19,color:#FFF
    classDef output fill:#66BB6A,stroke:#43A047,color:#FFF

    class plan,decisions input
    class identify,research,evaluate,recommend process
    class doc output
