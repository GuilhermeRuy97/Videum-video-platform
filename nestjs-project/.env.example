# Application
NODE_ENV=development
PORT=3000

# Database (PostgreSQL)
DB_HOST=db
DB_PORT=5432
DB_USERNAME=videum
DB_PASSWORD=videum
DB_NAME=videum

# JWT
JWT_SECRET=change-me-in-production
